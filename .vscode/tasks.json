{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Materials: verify package",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-B",
        "verify_package.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Materials: verify package and verifier failure checks",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-B",
        "verify_package.py",
        "--self-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Materials: Python correctness lint",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "ruff",
        "check",
        "--no-cache",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
